<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:VolunteerConnect.Components"
    x:Class="VolunteerConnect.Views.OpportunitiesPage"
    Title="Opportunities">


    <Grid Padding="20"
      RowDefinitions="Auto,Auto,*">


        <SearchBar
    x:Name="SearchBar"
    Placeholder="Search opportunities..."
    TextChanged="OnSearchChanged"/>



        <Picker Grid.Row="1"
        Title="Filter by Category"
        SelectedIndexChanged="OnCategoryChanged">

            <Picker.Items>

                <x:String>All</x:String>
                <x:String>Environment</x:String>
                <x:String>Community</x:String>
                <x:String>Animals</x:String>

            </Picker.Items>

        </Picker>



        <CollectionView Grid.Row="2"
                ItemsSource="{Binding Opportunities}">


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <components:OpportunityCardView/>

                </DataTemplate>

            </CollectionView.ItemTemplate>


        </CollectionView>


    </Grid>


</ContentPage>