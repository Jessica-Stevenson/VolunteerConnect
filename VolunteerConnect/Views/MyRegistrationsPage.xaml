<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect.Views.MyRegistrationsPage"
    Title="My Registrations">

    <Grid Padding="20">

        <CollectionView
            x:Name="RegistrationsCollectionView">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="10">

                    <Label
                        Text="No registrations found."
                        FontSize="20"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Your volunteer registrations will appear here."
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="0"
                        Margin="0,0,0,20"
                        StrokeShape="RoundRectangle 15">

                        <VerticalStackLayout
                            Spacing="0">

                            <!-- Opportunity Image -->

                            <Image
                                Source="{Binding Opportunity.ImageName}"
                                HeightRequest="180"
                                Aspect="AspectFill" />


                            <!-- Opportunity Details -->

                            <VerticalStackLayout
                                Padding="15"
                                Spacing="8">

                                <Label
                                    Text="{Binding Opportunity.Title}"
                                    FontSize="22"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Opportunity.Category,
                                           StringFormat='Category: {0}'}"
                                    FontSize="15" />

                                <Label
                                    Text="{Binding Opportunity.Date,
                                           StringFormat='Date: {0:dd MMMM yyyy}'}"
                                    FontSize="15" />

                                <Label
                                    Text="{Binding Opportunity.Time,
                                           StringFormat='Time: {0}'}"
                                    FontSize="15" />

                                <Label
                                    Text="{Binding Opportunity.Location,
                                           StringFormat='Location: {0}'}"
                                    FontSize="15" />


                                <!-- Divider -->

                                <BoxView
                                    HeightRequest="1"
                                    Margin="0,8" />


                                <!-- Registration Details -->

                                <Label
                                    Text="Registration Details"
                                    FontSize="19"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Registration.PreferredName,
                                           StringFormat='Name: {0}'}" />

                                <Label
                                    Text="{Binding Registration.ContactDetail,
                                           StringFormat='Contact: {0}'}" />

                                <Label
                                    Text="{Binding Registration.Availability,
                                           StringFormat='Availability: {0}'}" />

                                <Label
                                    Text="{Binding Registration.Notes,
                                           StringFormat='Notes: {0}'}" />

                                <Label
                                    Text="{Binding Registration.RegistrationDate,
                                           StringFormat='Registered: {0:dd MMMM yyyy}'}" />


                                <!-- Buttons -->

                                <HorizontalStackLayout
                                    Spacing="10"
                                    Margin="0,10,0,0">

                                    <Button
                                        Text="Edit"
                                        Clicked="OnEditClicked"
                                        HorizontalOptions="FillAndExpand" />

                                    <Button
                                        Text="Delete"
                                        Clicked="OnDeleteClicked"
                                        HorizontalOptions="FillAndExpand" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>