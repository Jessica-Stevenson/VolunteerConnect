<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolunteerConnect.Views.HomePage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="25"
                             Spacing="20">

            <Label Text="VolunteerConnect"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="VolunteerConnect helps you discover and register for local volunteer opportunities. Find causes you care about and make a difference in your community."
                   FontSize="16"
                   HorizontalTextAlignment="Center" />

            <Border StrokeShape="RoundRectangle 15"
                    Padding="20">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Featured Volunteer Opportunity"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <Image Source="{Binding ImageName}"
                           HeightRequest="180"
                           Aspect="AspectFill" />

                    <Label Text="{Binding Title}"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Label Text="{Binding Description}"
                           FontSize="15" />

                    <Label Text="{Binding Category, StringFormat='Category: {0}'}" />

                    <Label Text="{Binding Date, StringFormat='Date: {0:dddd d MMMM yyyy}'}" />

                    <Label Text="{Binding Location, StringFormat='Location: {0}'}" />

                    <Label Text="{Binding AvailablePlaces, StringFormat='Available Places: {0}'}" />

                </VerticalStackLayout>

            </Border>

            <Label x:Name="OpportunityCountLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Button Text="Browse Opportunities"
                    Clicked="OnBrowseOpportunitiesClicked"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>