<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VolunteerConnect.Components.OpportunityCardView">


    <Border Padding="15"
            Margin="10"
            StrokeShape="RoundRectangle 15">


        <VerticalStackLayout Spacing="8">


            <Image Source="{Binding ImageName}"
                   HeightRequest="120"/>

            <Label Text="{Binding Title}"
                   Style="{StaticResource CardTitle}"/>

            <Label Text="{Binding Category}"/>

            <Label Text="{Binding Date, StringFormat='{0:dd MMMM yyyy}'}" />

            <Label Text="{Binding Time}"/>

            <Label Text="{Binding Location}"/>

            <Label Text="{Binding Description}"/>

            <Label Text="{Binding AvailablePlaces,
                            StringFormat='Places Available: {0}'}"/>

            <Label Text="{Binding IsAvailable,
                            StringFormat='Available: {0}'}"/>

            <Button Text="View Details"
                    Clicked="OnDetailsClicked"/>


        </VerticalStackLayout>


    </Border>


</ContentView>