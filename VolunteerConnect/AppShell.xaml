<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VolunteerConnect.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VolunteerConnect"
    Title="VolunteerConnect">

    <!-- Bottom Tab Navigation -->
    <TabBar>

        <!-- Home -->
        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <!-- Opportunities -->
        <ShellContent
            Title="Opportunities"
            Icon="list.png"
            ContentTemplate="{DataTemplate local:OpportunitiesPage}"
            Route="OpportunitiesPage" />

        <!-- My Registrations -->
        <ShellContent
            Title="My Registrations"
            Icon="user.png"
            ContentTemplate="{DataTemplate local:MyRegistrationsPage}"
            Route="MyRegistrationsPage" />

        <!-- Privacy -->
        <ShellContent
            Title="Privacy"
            Icon="info.png"
            ContentTemplate="{DataTemplate local:PrivacyPage}"
            Route="PrivacyPage" />

    </TabBar>

</Shell>